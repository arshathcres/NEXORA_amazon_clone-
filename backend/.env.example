# PostgreSQL Database Connection
DATABASE_URL="postgresql://nexora_app:YOUR_DB_PASSWORD@localhost:5432/nexora?schema=public"

# JWT Signing Secret (Generate a random 32+ character string)
JWT_SECRET="your-secure-random-jwt-secret-min-32-chars-long"

# Server Port
PORT=5000

# Frontend Development Origin
FRONTEND_ORIGIN="http://localhost:5000"
